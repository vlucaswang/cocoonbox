[Unit]
Description=cocoonbox tool host (runs every tool as user)
ConditionPathExists=/usr/local/bin/cocoonbox-agent

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/workspace
Environment=HOME=/home/user
Environment=LANG=en_US.UTF-8
Environment=ANDROID_SERIAL=127.0.0.1:5555
Environment=TOOLHOST_SOCKET=/run/cocoonbox/toolhost.sock
ExecStart=/usr/local/bin/cocoonbox-agent toolhost
Restart=always
RestartSec=2s
TimeoutStopSec=5s
KillMode=mixed
OOMScoreAdjust=-900
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
