# Direct DeepSeek Platform API. /etc/gw/env supplies DEEPSEEK_API_KEY and admin tokens.
listen:
  host: 10.203.0.1
  port: 18090
storage:
  postgres_url: postgres:///gw?host=/var/run/postgresql&user=gw
providers:
  - name: deepseek
    kind: deepseek
    api_key_env: DEEPSEEK_API_KEY
    timeout_seconds: 300
accounts: []
models:
  # Peak list rates as of 2026-10-18; off-peak vendor billing is lower.
  # Units: micro-dollars per 1,000 tokens. Cache reads cost 2% of input.
  - name: deepseek-flash
    provider: deepseek
    input_price_per_1k_micros: 300
    output_price_per_1k_micros: 1200
    token_rate:
      read_cache: 0.02
tenants:
  - name: cocoonbox-boxes
    qps: 160
    daily_cost_quota_micros: 50000000
    user_daily_cost_quota_micros: 5000000
    require_key_owner: true
    admin_token_env: CB_BOXES_ADMIN_TOKEN
    models: [deepseek-flash]
admin:
  token_env: GW_ADMIN_TOKEN
access_keys: []
