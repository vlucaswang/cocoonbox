#!/usr/bin/env python3
"""Writes /srv/cb/sbx/sandboxd.json (root 0600) with one pool per template.
usage: cbsbx-conf <template>=<warm> [<template>=<warm> ...]   the first is the default image
With an egress CA under /etc/cocoonbox/egress-ca, CB_EGRESS_INTERMEDIATE names its intermediate cert and key.
CB_MAX_CLAIMS caps the node's live claims, hibernated ones included (default 16)."""

import json
import os
import re
import sys

S = "/srv/cb/sbx"
TOKEN = "/etc/cocoonbox/sandboxd-token"
EGRESS_CA = "/etc/cocoonbox/egress-ca"
LISTEN = "127.0.0.1:17780"
GATEWAY = "10.203.0.1"
GW_PORT = 18090
CONNECT_PORT = 18091
APT_PORT = 3142
STATE_PORT = int(os.environ.get("CB_STATE_PORT", "19000"))
RESIDENTIAL = "10.203.1.2"
STORAGE = "40G"
WARMUP = ("for i in $(seq 1 600); do systemctl -q is-active cocoonbox-xorg cocoonbox-session cocoonbox-toolhost cocoonbox-agent "
          "&& (exec 3<>/dev/tcp/127.0.0.1/5900) 2>/dev/null && (exec 3<>/dev/tcp/127.0.0.1/7443) 2>/dev/null && exit 0; "
          "sleep 0.2; done; exit 1")
# a headless run in a throwaway profile puts Chrome's pages in the golden's page cache without opening a window
CHROME_WARMUP = ("(" + WARMUP + ") && { runuser -u user -- env HOME=/home/user timeout 30 google-chrome --headless=new "
                 "--no-first-run --user-data-dir=/tmp/cb-warmup-chrome --dump-dom about:blank > /dev/null 2>&1; "
                 "rm -rf /tmp/cb-warmup-chrome; true; }")
# an Android golden holds the outer VM only: Android boots per box once the api writes the box identity
ANDROID_WARMUP = ("for i in $(seq 1 600); do systemctl -q is-active cocoonbox-toolhost cocoonbox-agent "
                  "&& (exec 3<>/dev/tcp/127.0.0.1/7443) 2>/dev/null && exit 0; sleep 0.2; done; exit 1")
ANDROID_FAMILIES = ("cbdroid",)
CHROME_WARMUP_FROM = 15
INJECT_FROM = 23
CONNECT_FROM = 24

if len(sys.argv) < 2 or any("=" not in a for a in sys.argv[1:]):
    sys.exit(__doc__)
gw = {"host": GATEWAY, "ports": [GW_PORT], "secret": "GW_KEY"}
connect = {"host": GATEWAY, "ports": [CONNECT_PORT], "secret": "CB_CONNECT_KEY"}
inject = {"host": "*", "intercept": "inject"}
rest = [{"host": "*"}]
egress = {"allow": [gw, *rest]}
inject_egress = {"allow": [gw, inject, *rest]}
# the door key rule precedes the inject rule, since a plain request takes the first rule that matches
connect_egress = {"allow": [gw, connect, inject, *rest]}
pools = []
for arg in sys.argv[1:]:
    template, warm = arg.rsplit("=", 1)
    version = re.fullmatch(r"([a-z0-9]+):v(\d+)(-\w+)?", template)
    # every family but cbdesk is cut from a template with the newest rules
    n = 0 if not version else int(version[2]) if version[1] == "cbdesk" else CONNECT_FROM
    if version and version[1] in ANDROID_FAMILIES:
        warmup = ANDROID_WARMUP
    else:
        warmup = CHROME_WARMUP if n >= CHROME_WARMUP_FROM else WARMUP
    pools.append({"template": template, "net": "none", "size": "xlarge", "storage": STORAGE, "warm": int(warm),
                  "warmup": ["bash", "-c", warmup],
                  "egress": connect_egress if n >= CONNECT_FROM else inject_egress if n >= INJECT_FROM else egress})
conf = {
    "listen": LISTEN,
    "advertise_addr": LISTEN,
    "data_dir": f"{S}/data",
    "cocoon_bin": f"{S}/bin/cocoon-cbsbx",
    "cocoond_socket": f"{S}/run/cocoond.sock",
    "restore_mode": "mmap",
    "no_direct_io": True,
    "sync_claims": True,
    "vmm_restart": "cold",
    "api_token": open(TOKEN).read().strip(),
    "max_claims": int(os.environ.get("CB_MAX_CLAIMS", "16")),
    "refill_concurrency": 1,
    "audit_log": True,
    "egress_internal_allow": [f"{GATEWAY}/32:{GW_PORT},{CONNECT_PORT},{APT_PORT},{STATE_PORT}"],
    "egress_upstream": {"claim_env": "EGRESS_UPSTREAM", "allow": [f"{RESIDENTIAL}/32"]},
    "egress_classes": [{"name": "cbdesk", "egress": egress}],
    "secrets": [{"name": "GW_KEY", "header": "Authorization"}, {"name": "CB_CONNECT_KEY", "header": "Authorization"}],
    "pools": pools,
}
if os.path.exists(f"{EGRESS_CA}/root.crt"):
    conf["egress_ca"] = {"root_cert": f"{EGRESS_CA}/root.crt",
                         "intermediate_cert": f"{EGRESS_CA}/{os.environ['CB_EGRESS_INTERMEDIATE']}.crt",
                         "intermediate_key": f"{EGRESS_CA}/{os.environ['CB_EGRESS_INTERMEDIATE']}.key"}
path = f"{S}/sandboxd.json"
fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(conf, f, indent=1)
os.replace(path + ".tmp", path)
print("wrote", path, "pools", [(p["template"], p["warm"]) for p in pools])
